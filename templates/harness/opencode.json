{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/rules/*.md"],
  "mcp": {
    "laravel-boost": {
      "type": "local",
      "command": ["php", "__BOOST_ARTISAN__", "boost:mcp"],
      "enabled": true
    },
    "mobbin": {
      "type": "remote",
      "url": "https://api.mobbin.com/mcp",
      "enabled": true
    }
  }
}
